{
    "name": "josbeir/cakephp-latte-view",
    "description": "Latte view plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "^6.0@dev",
        "latte/latte": "~3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "cakephp/plugin-installer": "^2.0.1",
        "cakephp/cakephp-codesniffer": "^6.0@dev",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7",
        "cakephp/debug_kit": "^6.0@dev"
    },
    "autoload": {
        "psr-4": {
            "LatteView\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LatteView\\TestApp\\": "tests/test_app/src/",
            "LatteView\\TestPlugin\\": "tests/test_app/plugins/Test/src/",
            "LatteView\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lowest": "validate-prefer-lowest",
        "test": "phpunit --colors=always",
        "test-coverage": "export XDEBUG_MODE=coverage; phpunit --log-junit tmp/coverage/unitreport.xml --coverage-html tmp/coverage --coverage-clover tmp/coverage/coverage.xml",
        "stan": "phpstan analyse",
        "cs-check": "phpcs --colors -p -s",
        "cs-fix": "phpcbf --colors -p -s",
        "rector": "rector --ansi",
        "rector-check": "rector process --dry-run --ansi"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
